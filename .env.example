# 服务端配置（server/）。只在这里放占位值，真值由 /wizard 写进 .env（已被 gitignore）。
# 前端构建时另用 VITE_API_BASE_URL 指向这个服务，见 README。

# 回调服务的对外基地址，三家后台登记的 redirect_uri 都以它为基；不带末尾斜杠。
APP_BASE_URL=https://api.example.com

# 面板所在源（Qoder Sites 地址）。CORS 只放行它，回调完成后也跳回它。
FRONTEND_URL=https://triage360.example.qoder.zone

# 监听端口；前面有反代时只听回环口，由反代转发。
PORT=8787

# GitHub OAuth App（T09 用这一对）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 以下两对在 #17 / #19 接通前不会被读取。
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
