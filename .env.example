# 服务端配置（server/）。只在这里放占位值，真值由 /wizard 写进 .env（已被 gitignore）。
# 前端构建时另用 VITE_API_BASE_URL 指向这个服务，见 README。

# 回调服务的对外基地址，三家后台登记的 redirect_uri 都以它为基；不带末尾斜杠。
APP_BASE_URL=https://api.example.com

# 面板所在源（Qoder Sites 地址）。CORS 只放行它，回调完成后也跳回它。
FRONTEND_URL=https://triage360.example.qoder.zone

# 监听地址与端口。默认只听回环口，TLS 与对外入口都归反代；没有反代时才改 `HOST`。
HOST=127.0.0.1
PORT=8787

# 加密账本与密钥的落点（#13）。默认 .data/（已 gitignore）；线上由 deploy.sh 指到 /var/lib/triage360。
# DATA_DIR=.data

# GitHub OAuth App（T09 用这一对）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 「为什么是这几条」的措辞通道（#8）。留空 = 未配置：接口回 503，面板回落到纯规则理由。
DEEPSEEK_API_KEY=
# 可选：换兼容端点或模型名（默认 https://api.deepseek.com + deepseek-flash）。
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# Gitee OAuth（#17）：必须成对配置；缺一项服务端起不来，两项都缺就只关掉 Gitee 链路。
# 回调地址登记 https://<APP_BASE_URL 的域名>/cb/gitee；权限勾 user_info / projects / issues。
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# 演示租户（#15）：给了 DEMO_LOGIN 才启用公开演示快照与定时刷新。
# 演示账号先走一次面板授权（GitHub 至少公开档，Gitee 可选），服务端就会按这个登录名找回账本。
# DEMO_LOGIN=
# 刷新间隔（分钟，默认 15，下限 1）；与访问量无关。
# DEMO_REFRESH_MINUTES=15
# 维护者重置入口 POST /api/demo/reset 的 Bearer；不配就不存在这个入口。
# DEMO_RESET_TOKEN=

# Atlassian（#19 接通前不会被读取）。
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
